{% stylesheet %}
    /* This could be split into multiple files, but for simplicity, we keep it in one. */

    /* Also note that this Liquid file is only used because the previous custom.css file was overwritten by the theme styles. */

    :root {
        --color-instock: #25A525;
        --narrow-page-width: 1200px;
    }

    /* Product Information Details */
    .product-details {
        box-shadow: 0px 3px 20px #00000029;
        border: 1px solid #D5D5D5;
        border-radius: 5px;
        padding-right: calc(var(--gap, 0) / 2);
        align-self: center !important;
        max-width: 475px;
    }

    .text-block.h3 h1 {
        color: var(--color-black);
        font-size: 25px;
        line-height: 30px;
        font-weight: 600;
    }

    .product-subtitle{
        color: var(--color-black);
        font-size: 18px;
        line-height: 22px;
        font-weight: normal;
    }

    .group-compare-at-price {
        margin-right: 20px;
    }

    .compare-at-price {
        opacity: 1;
        font-size: 18px;
        line-height: 22px;
        color: var(--color-black);
        font-weight: 600;
    }

    .price {
        font-size: 18px;
        line-height: 22px;
        color: #1F47FF;
        font-weight: 600;
    }

    .taxes-included-note {
        color: var(--color-black);
        font-size: 10px;
        line-height: 13px;
        font-weight: normal;
    }

    .product-inventory__icon {
        width: 15px;
        height: 15px;
    }

    .product-inventory__text, .delivery-time {
        color: var(--color-instock);
        font-size: 15px;
        font-weight: normal;
        line-height: 19px;
    }

    .button[id^='BuyButtons-ProductSubmitButton-'] {
        font-size: 18px;
        font-weight: 600;
        line-height: 22px;
    }
    /* Product Information Details End */


    /*  IMAGE GALLERY */

    /* Navigation Dots */
    slideshow-component slideshow-controls[controls-on-media] {
        position: relative;
    }
    slideshow-component .slideshow-controls__dots button {
        width: 10px;
        height: 10px;
        margin: calc(5px / -2);
        background: #F8F8F8 0% 0% no-repeat;
        border: none;
    }
    slideshow-component .slideshow-controls__dots button[aria-selected="true"] {
        background: #E5E5E5 0% 0% no-repeat;
        box-shadow: inset 0px 3px 6px #00000029;
    }   
    slideshow-component .slideshow-controls__dots button::after {
        content: none;
    }


    slideshow-arrows {
        inset: unset;
    }

    slideshow-arrows[position="center"]{
        left: 0;
        right: 0;
        justify-content: center;
    }

    slideshow-arrows .slideshow-control {
        color: var(--color-black);
    }
    slideshow-arrows .slideshow-control[disabled] {
        opacity: 0.3;
    }
    slideshow-arrows .slideshow-control svg {
        width: 24px;;
    }
    slideshow-arrows .slideshow-control.slideshow-control--previous {
        margin-right: 12px;
    }

    /* Slides */
    slideshow-slides {
        gap: 7px;
    }

    slideshow-slides img, slideshow-slides {
        border-radius: 5px;
    }

    /* Thumbnails Container */
    .slideshow-controls__thumbnails-container .slideshow-controls__thumbnails {
        gap: 13px;
        padding-top: 0;
        padding-right: 2px;
        margin-top: 0;
    }

    /* Thumbnails */
    .slideshow-controls__thumbnails-container .slideshow-controls__thumbnails .slideshow-control {
        width: clamp(100px, 7vw, var(--thumbnail-width));
        aspect-ratio: 1 / 1;
    }

    /* prevents large images from overflowing the viewport when zoomed in */
    .product-media__drag-zoom-wrapper .product-media {
        width: 100vw;
        height: 100vh;
    }
    /* Image Gallery End */


    /* Media Queries Up */
    @media screen and (min-width: 750px) {
        slideshow-controls {
            margin-right: 20px;
        }

        slideshow-container {
            overflow: visible !important;
        }
       
    }
    /* Grid Layout */
    @media screen and (min-width: 1200px) {
        .product-information__grid.product-information--media-left:not(.product-information__grid--half):not(.product-information--media-none),
        .product-information__grid.product-information--media-right:not(.product-information__grid--half):not(.product-information--media-none) {
            grid-template-columns: 1fr 1fr;
        }
         .product-information__grid.product-information--media-left:not(.product-information__grid--half):not(.product-information--media-none) .product-information__media {
            padding-right: 50px;
        }
    }

    /* Media Queries Down */
    @media screen and (max-width: 990px) {
        .slideshow-controls__thumbnails-container .slideshow-controls__thumbnails .slideshow-control {      
            width: clamp(70px, 7vw, var(--thumbnail-width));
        }
    }
    @media screen and (max-width: 860px) {
        .slideshow-controls__thumbnails-container .slideshow-controls__thumbnails .slideshow-control {      
            width: clamp(50px, 7vw, var(--thumbnail-width));
        }
    }
    @media screen and (max-width: 750px) {
        .text-block.h3 h1 {
            font-size: 22px;
            line-height: 27px;
        }
        .product-subtitle, .compare-at-price, .price, .product-inventory__text, .delivery-time, .button[id^='BuyButtons-ProductSubmitButton-'] {
            font-size: 16px;
            line-height: 19px;
        }

        .product-details {
            padding-left: calc(var(--gap, 0) / 2);
        }
        slideshow-slide {
            max-width: calc(100% - 36px);
        }
    }
{% endstylesheet %}